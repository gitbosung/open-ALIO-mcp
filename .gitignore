# ── 비밀·환경 (절대 커밋 금지) ──
.env
.env.local
.env.*
!.env.example
.envrc
*.pem
*.key

# ── Python ──
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Web app / Node
node_modules/
.next/
out/
.vercel/
.turbo/
coverage/

# ── MCP / 런타임 캐시 (설계서 §6-3) ──
data/cache/*
!data/cache/.gitkeep

# ── OS / IDE ──
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.claude/
*.swp
*.swo
~$*.pptx
~$*.docx
~$*.xlsx

# ── 로그·임시 ──
*.log
tmp/
temp/
_tmp_*
rawdata/handbook/_probe*.txt

# ── 데이터 파이프라인 — Git push 제외 (uvx/Release에도 미포함) ──
# 파서·크롤러(parse_alio.py 등)는 Git 추적 OK — wheel/스냅샷에는 안 실림
# 원본 raw 데이터 (hwpx·pdf·xls·html 등 — 대량, 재수집 가능, push 금지)
rawdata/
# 크롤·빌드 중간 산출물 (재생성 가능, push 금지 — pre-commit도 차단)
data/crawl/
data/canonical/*.jsonl
data/canonical/*_summary.json
data/canonical/*.db
data/canonical/*.db-shm
data/canonical/*.db-wal
data/canonical/*.sqlite
data/canonical/*.sqlite-shm
data/canonical/*.sqlite-wal
data/canonical/metrics_v2/
data/canonical/metrics_v2_sample/
data/_report_organ_counts.json
data/items.json
data/items_catalog.json
data/metrics/_crawl_promotion_report.json
data/validation_reports/canonical_v2_quality*.json
data/validation_reports/canonical_v2_metrics*.json

# Local parser/data archives: keep manifests in Git, keep bulky parsed data local.
archive/*/data/
