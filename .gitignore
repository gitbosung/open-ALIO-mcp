# ── 비밀·환경 (절대 커밋 금지) ──
.env
.env.local
.env.*
!.env.example
.envrc
*.pem
*.key

# ── Python ──
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Web app / Node
node_modules/
.next/
out/
.vercel/
.turbo/
coverage/

# ── MCP / 런타임 캐시 (설계서 §6-3) ──
data/cache/*
!data/cache/.gitkeep

# ── OS / IDE ──
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
~$*.pptx
~$*.docx
~$*.xlsx

# ── 로그·임시 ──
*.log
tmp/
temp/
_tmp_*
rawdata/handbook/_probe*.txt

# ── 대용량·민감 raw (선택적) ──
# API 키가 URL에 포함된 curl 기록 등은 커밋하지 않음
rawdata/**/with-key/
rawdata/**/*.secret.*

# ── ALIO 크롤러 raw HTML (대량, 재수집 가능) ──
rawdata/html/
