{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gitbosung/open-ALIO-mcp/data/canonical/schema.json",
  "title": "ALIO canonical parser v2 record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "org_code",
    "org_name",
    "item_no",
    "item_name",
    "as_of",
    "record_type",
    "section_title",
    "table_index",
    "table_title",
    "row_header_path",
    "col_header_path",
    "row_index",
    "col_index",
    "period_label",
    "period_year",
    "period_type",
    "metric_label",
    "unit",
    "raw_value",
    "normalized_value",
    "text_value",
    "file_name",
    "file_href",
    "source_html_path",
    "parser_warning"
  ],
  "properties": {
    "org_code": {"type": "string"},
    "org_name": {"type": "string"},
    "item_no": {"type": "string"},
    "item_name": {"type": "string"},
    "as_of": {"type": "string"},
    "record_type": {
      "type": "string",
      "enum": ["time_series", "roster", "attribute", "text_rule", "attachment"]
    },
    "section_title": {"type": "string"},
    "table_index": {"type": "integer", "description": "Zero-based top-level audited table index; -1 for non-table nb disclosures."},
    "table_title": {"type": "string"},
    "row_header_path": {"type": "string"},
    "col_header_path": {"type": "string"},
    "row_index": {"type": ["integer", "null"], "description": "Zero-based expanded table row index, including inferred/header rows."},
    "col_index": {"type": ["integer", "null"], "description": "Zero-based expanded table column index."},
    "period_label": {"type": "string"},
    "period_year": {"type": "string", "pattern": "^(20[0-9]{2})?$"},
    "period_type": {"type": "string"},
    "metric_label": {"type": "string"},
    "unit": {"type": "string"},
    "raw_value": {"type": "string"},
    "normalized_value": {"type": ["number", "integer", "null"]},
    "text_value": {"type": "string"},
    "file_name": {"type": "string"},
    "file_href": {"type": "string"},
    "source_html_path": {"type": "string"},
    "parser_warning": {"type": "string"}
  }
}
