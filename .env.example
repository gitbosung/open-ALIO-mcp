# 공공데이터포털 일반인증키 (Decoding 값)
DATA_GO_KR_SERVICE_KEY=

# 재정경제부_공공기관 정보 조회 서비스 (활용신청 → 개발계정 상세보기 End Point)
PUBLIC_INST_BASE_URL=https://apis.data.go.kr/1051000/public_inst

# 재정경제부_공공기관 시설정보 조회서비스
PUBLIC_FACILITY_BASE_URL=https://apis.data.go.kr/1051000/fclt

# 재정경제부_공공기관 사업정보 조회서비스
PUBLIC_BIZ_BASE_URL=https://apis.data.go.kr/1051000/biz

# 재정경제부_공공기관 채용정보 조회서비스
PUBLIC_RECRUIT_BASE_URL=https://apis.data.go.kr/1051000/recruitment

# 네이버 검색 API (뉴스) — developers.naver.com 앱 등록 후 발급 (get_institution_news용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 국가법령정보센터 Open API — open.law.go.kr 회원가입 → 'Open API 사용 신청' → OC 발급
# OC는 가입 이메일의 ID 부분 (예: hong@gmail.com → hong). 법령·행정규칙 도구용.
LAW_API_OC=

# MCP 응답 보호: LLM context와 클라이언트 안정성을 위해 긴 응답을 자릅니다.
MAX_RESPONSE_CHARS=50000
MAX_ITEMS_PER_TOOL=100

# 향후 HTTP/SSE 배포 시 사용합니다. 현재 기본 실행(server.py)은 stdio MCP입니다.
# 운영·공개 배포에서는 * 대신 실제 허용 도메인을 지정하세요.
CORS_ORIGIN=http://localhost:3000
